{
  "name": "turtlebot-execution-broker",
  "version": "0.1.0",
  "private": true,
  "description": "TurtleBot public Railway execution broker. JWT-authenticated entrypoint that authorizes ApeX Omni intents against Supabase, then delegates signing to the private Railway signer over HMAC. Never receives or returns signer secrets.",
  "type": "module",
  "engines": {
    "node": ">=22 <27"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/rate-limit": "11.2.0",
    "@supabase/supabase-js": "2.116.0",
    "fastify": "5.12.4",
    "jose": "6.2.12",
    "pino": "10.3.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "tsx": "4.19.2",
    "vitest": "4.1.11",
    "typescript": "5.6.3"
  },
  "overrides": {
    "fast-uri": "3.1.6"
  }
}
