{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "tanstack-start",
  "outputDirectory": ".output/public",
  "crons": [
    {
      "path": "/api/public/hooks/paper-tick",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/public/hooks/committee-cycle",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/public/hooks/missed-opportunity-review",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/public/hooks/ai-advisory",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/public/hooks/live-advisory",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/public/hooks/live-fills",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/public/hooks/tp-council",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/public/hooks/watchdog-snapshot",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/public/hooks/live-positions",
      "schedule": "* * * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  }
}
