# Quorumark Strategy Exchange configuration

# Public application URL. Used for domain bound wallet challenges and redirects.
VITE_APP_URL=https://your-quorumark-domain.example

# Python strategy engine. Required for Strategy Studio backend backtests.
# Local default: http://127.0.0.1:8000. Public client URL only.
VITE_PYTHON_BACKEND_URL=http://127.0.0.1:8000
QUORUMARK_PYTHON_ENVIRONMENT=local
# Backend persistence mode. `sqlite` is explicit local development mode;
# production requires Quorumark-owned Supabase integration.
QUORUMARK_PYTHON_PERSISTENCE=sqlite
QUORUMARK_SQLITE_PATH=backend/.data/quorumark.db
# Server-side database URL for the future Supabase/Postgres repository adapter.
QUORUMARK_DATABASE_URL=
# Server-only Supabase secret key. Required when QUORUMARK_PYTHON_ENVIRONMENT is hosted.
QUORUMARK_SUPABASE_URL=https://your_quorumark_project_ref.supabase.co
QUORUMARK_SUPABASE_SECRET_KEY=sb_secret_...

# Quorumark owned Supabase project. Public client values only.
# Obtain from Supabase Project Settings → API. Never use a service role key here.
VITE_SUPABASE_PROJECT_ID=your_quorumark_project_ref
VITE_SUPABASE_URL=https://your_quorumark_project_ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Server only. Used to sign short lived application sessions and challenge state.
QUORUMARK_SESSION_SECRET=replace_with_a_random_server_secret

# Native NEAR wallet integration. The current demo uses Wallet Selector's
# built-in Meteor and My NEAR Wallet modules; no custom connector URL is read.
VITE_NEAR_NETWORK=testnet
VITE_NEAR_RPC_URL=https://rpc.testnet.near.org
VITE_NEAR_EVIDENCE_CONTRACT_ID=
QUORUMARK_NEAR_EVIDENCE_CONTRACT_ID=

# EVM wallet discovery. WalletConnect is optional and public.
VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id
VITE_EVM_CHAIN_IDS=11155111

# Reserved for a future NEAR Intents relay integration. The current adapter is
# sandbox-only and deliberately refuses quotes, preparation, and settlement
# verification, so these values are not required for the demo.
NEAR_INTENTS_ENVIRONMENT=sandbox
NEAR_INTENTS_RELAY_URL=
NEAR_INTENTS_API_KEY=

# The current backtest uses deterministic, labeled fixture candles supplied by
# the application. No external market-data provider is called.
MARKET_DATA_PROVIDER=paper_fixture
MARKET_DATA_API_KEY=

# The current evaluation endpoint uses deterministic safety notes only. No
# model provider or AI API key is called.
AI_PROVIDER=disabled
AI_API_KEY=

# Execution safety. The exchange demo must remain paper or supported testnet.
QUORUMARK_EXECUTION_ENVIRONMENT=paper
QUORUMARK_ALLOW_LIVE_EXECUTION=false
